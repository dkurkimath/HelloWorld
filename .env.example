# Postgres connection string from your hosting provider (Neon, Supabase, Render, etc.)
# Example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The real deployed URL of the site, e.g. https://portal.sophiaway.org
NEXTAUTH_URL=

# From resend.com, after verifying the sophiaway.org sending domain
RESEND_API_KEY=
MAIL_FROM="Sophia Way Portal <notifications@sophiaway.org>"
